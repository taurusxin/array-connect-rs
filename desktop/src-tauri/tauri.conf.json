{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Array Connect",
  "version": "0.1.0",
  "identifier": "com.taurusxin.arrayconnect",
  "build": {
    "beforeDevCommand": "pnpm prepare && pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm prepare && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Array Connect", "width": 1180, "height": 800, "minWidth": 960, "minHeight": 680, "decorations": false, "center": true }],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; frame-src 'none'" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Array Networks SSL VPN desktop client",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": { "nsis": { "languages": ["SimpChinese", "English"] } }
  }
}
