{
  "build": {
    "beforeDevCommand": "node scripts/prepare-macos-service.mjs && pnpm dev",
    "beforeBuildCommand": "node scripts/prepare-macos-service.mjs && pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Array Connect",
        "width": 1180,
        "height": 800,
        "minWidth": 960,
        "minHeight": 680,
        "decorations": true,
        "titleBarStyle": "Visible",
        "center": true
      }
    ]
  },
  "bundle": {
    "resources": {
      "gen/macos/array-connect-vpnd": "array-connect-vpnd"
    },
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": true
    }
  }
}
